{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/doc-schema/common.schema.json",
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "base": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "supersedes": {
          "$ref": "#/$defs/refs"
        },
        "superseded-by": {
          "$ref": "#/$defs/ref"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  }
}