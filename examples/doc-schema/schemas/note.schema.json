{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/doc-schema/note.schema.json",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "draft",
        "current",
        "superseded"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "created"
  ],
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/base"
    }
  ],
  "unevaluatedProperties": false
}